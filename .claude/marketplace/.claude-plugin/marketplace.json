{
  "name": "local-fivem",
  "owner": {
    "name": "local"
  },
  "plugins": [
    {
      "name": "qbx-lua",
      "description": "Qbox Lua language server for FiveM and CfxLua. Requires qbx-lua-ls 1.1.0 on PATH.",
      "version": "1.1.0",
      "author": {
        "name": "Qbox-project"
      },
      "source": "./plugins/qbx-lua",
      "category": "development",
      "lspServers": {
        "qbx-lua": {
          "command": "qbx-lua-ls",
          "extensionToLanguage": {
            ".lua": "lua"
          }
        }
      }
    }
  ]
}
